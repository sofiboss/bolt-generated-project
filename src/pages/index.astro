---
import Layout from '../layouts/Layout.astro';
---

<Layout title="مركز التكوين المهني والتمهين تيمقاد">
  <div class="container mx-auto px-4 py-8">
    <section class="text-center mb-12">
      <h1 class="text-4xl font-bold mb-4">مرحباً بكم في مركز التكوين المهني والتمهين تيمقاد</h1>
      <p class="text-xl text-gray-600">نقدم أفضل برامج التدريب المهني لبناء مستقبلك المهني</p>
    </section>

    <section class="grid md:grid-cols-3 gap-8 mb-12">
      <div class="bg-white p-6 rounded-lg shadow-md">
        <h2 class="text-xl font-bold mb-4">البرامج التدريبية</h2>
        <p>اكتشف برامجنا المتنوعة في مختلف المجالات المهنية</p>
        <a href="/programs" class="text-blue-600 mt-4 inline-block">اكتشف المزيد →</a>
      </div>

      <div class="bg-white p-6 rounded-lg shadow-md">
        <h2 class="text-xl font-bold mb-4">التسجيل</h2>
        <p>سجل الآن للانضمام إلى برامجنا التدريبية</p>
         <p class="mt-2 text-sm text-gray-600">يمكن للمتربصين التسجيل من خلال الرابط التالي: <a href="https://www.takwin.dz/" class="text-blue-600">https://www.takwin.dz/</a></p>
      </div>

      <div class="bg-white p-6 rounded-lg shadow-md">
        <h2 class="text-xl font-bold mb-4">آخر الأخبار</h2>
        <p>تابع آخر الأخبار والفعاليات في المركز</p>
        <a href="/news" class="text-blue-600 mt-4 inline-block">المزيد من الأخبار →</a>
      </div>
    </section>
    
    <section class="bg-gray-50 p-8 rounded-lg mb-8">
      <h2 class="text-2xl font-bold mb-6 text-center">لماذا تختار مركزنا؟</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div>
          <h3 class="text-lg font-bold mb-2">خبرة متميزة</h3>
          <p>فريق من المدربين المحترفين ذوي الخبرة العالية</p>
        </div>
        <div>
          <h3 class="text-lg font-bold mb-2">شهادات معتمدة</h3>
          <p>شهادات معترف بها من وزارة التكوين المهني</p>
        </div>
        <div>
          <h3 class="text-lg font-bold mb-2">تدريب عملي</h3>
          <p>تدريب عملي مكثف في بيئة احترافية</p>
        </div>
        <div>
          <h3 class="text-lg font-bold mb-2">فرص عمل</h3>
          <p>شراكات مع الشركات لتوفير فرص عمل للخريجين</p>
        </div>
      </div>
    </section>

    <section class="text-center">
      <h2 class="text-2xl font-bold mb-4">كلمة المدير</h2>
      <p class="text-lg italic">
        (سيتم إضافة كلمة المدير هنا)
      </p>
    </section>
  </div>
</Layout>
